{
  "name": "comercechat",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @comercechat/api db:generate",
    "db:migrate": "pnpm --filter @comercechat/api db:migrate",
    "db:seed": "pnpm --filter @comercechat/api db:seed",
    "poc:keys": "node scripts/poc-keys.mjs",
    "poc:up": "bash scripts/poc-up.sh",
    "poc:tunnel": "node scripts/poc-tunnel.mjs",
    "e2e": "pnpm --filter @comercechat/e2e e2e",
    "poc:stop": "node scripts/poc-stop.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
