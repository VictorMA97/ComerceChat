# Copia generada por `pnpm poc:keys` en .env.local (con secretos aleatorios). No edites secretos aquí.
NODE_ENV=development

# --- Infraestructura local (docker compose) ---
DATABASE_URL=postgres://comercechat:comercechat@localhost:5432/comercechat
REDIS_URL=redis://localhost:6379
SMTP_URL=smtp://localhost:1025

# --- URLs ---
API_PORT=4000
API_BASE_URL=http://localhost:4000
# URL base que se codifica en los QR. Para probar desde el móvil usa tu IP de red local o un túnel HTTPS.
WEB_QR_BASE_URL=http://localhost:3000
MERCHANT_PANEL_BASE_URL=http://localhost:3001

# --- Selectores de proveedores (ARCHITECTURE §16.2). En producción no se permite fake/console/local. ---
PAYMENT_PROVIDER=fake
POS_CONNECTOR=fake
OTP_SENDER=console
QUEUE_DRIVER=bullmq
STORAGE_DRIVER=local
AUTH_PROVIDER=local
TELEMETRY=off

# --- Secretos (los rellena `pnpm poc:keys`) ---
JWT_SECRET=
QR_HMAC_SECRET=
QR_SIGNING_KEY=
PII_ENCRYPTION_KEY=
FAKE_PSP_WEBHOOK_SECRET=
