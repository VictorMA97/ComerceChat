# Copia generada por `pnpm poc:keys` en .env.local (con secretos aleatorios). No edites secretos aquí.
NODE_ENV=development

# --- Infraestructura local (docker compose) ---
DATABASE_URL=postgres://comercechat:comercechat@localhost:5432/comercechat
REDIS_URL=redis://localhost:6379
SMTP_URL=smtp://localhost:1025

# --- URLs ---
API_PORT=4000
API_BASE_URL=http://localhost:4000
# URL base que se codifica en los QR. `pnpm poc:tunnel` la cambia por la de un túnel HTTPS para probar desde el móvil.
WEB_QR_BASE_URL=http://localhost:3000
MERCHANT_PANEL_BASE_URL=http://localhost:3001

# --- Selectores de proveedores (ARCHITECTURE §16.2). En producción no se permite fake/console/local. ---
PAYMENT_PROVIDER=fake
POS_CONNECTOR=fake
OTP_SENDER=console
QUEUE_DRIVER=bullmq
STORAGE_DRIVER=local
AUTH_PROVIDER=local
TELEMETRY=off

# --- Procesos y colas (ADR-021) ---
# all = HTTP + workers en el mismo proceso; http / worker para separarlos.
PROCESS_ROLE=all
QUEUE_PREFIX=cc

# --- Pagos (valores provisionales de la PoC) ---
# Comisión de plataforma: puntos básicos sobre el importe sin propina (D-05 abierta).
PLATFORM_FEE_BPS=50
PLATFORM_FEE_FIXED_CENTS=0
# Máximo por pago sin cuenta de usuario (FR-PAY-09).
GUEST_MAX_PAYMENT_CENTS=30000
PAYMENT_SESSION_TTL_SECONDS=900
# Vida de un QR dinámico de mostrador (FR-QR-03).
DYNAMIC_QR_TTL_SECONDS=300
# Webhooks del PSP simulado retrasados, duplicados y desordenados.
FAKE_PSP_CHAOS=off

# --- Secretos (los rellena `pnpm poc:keys`) ---
JWT_SECRET=
QR_HMAC_SECRET=
QR_SIGNING_KEY=
PII_ENCRYPTION_KEY=
FAKE_PSP_WEBHOOK_SECRET=
