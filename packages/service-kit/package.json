{
  "name": "@comercechat/service-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/base-env.d.ts",
      "default": "./dist/config/base-env.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "default": "./dist/telemetry.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@comercechat/contracts": "workspace:*",
    "@comercechat/shared-types": "workspace:*",
    "@aws-sdk/client-sqs": "^3.1165.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/instrumentation": "^0.301.1",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.1",
    "@opentelemetry/instrumentation-ioredis": "^0.73.0",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "bullmq": "^6.7.3",
    "helmet": "8.3.0",
    "ioredis": "^6.0.0",
    "uuidv7": "^1.2.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "6.7.1",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "6.7.1",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0",
    "@swc/core": "^1.16.22",
    "vitest": "^5.1.0"
  }
}
